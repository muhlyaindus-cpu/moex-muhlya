[Unit]
Description=Miya online candle monitor snapshot
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=traderbot
Group=traderbot
SupplementaryGroups=docker

# Override in drop-in if needed:
#   ONLINE_MIA_REPORTS_DIR
#   ONLINE_MIA_CANDLE_SHORT_MIN
#   ONLINE_MIA_CANDLE_LONG_MIN
#   ONLINE_MIA_CANDLE_MIN_POINTS
#   ONLINE_MIA_CANDLE_FALLBACK_MIN
#   ONLINE_MIA_CANDLE_USE_FALLBACK_IN_ACTIVE
#   ONLINE_MIA_BULLISH_THRESHOLD_PCT
#   ONLINE_MIA_BEARISH_THRESHOLD_PCT
#   ONLINE_MIA_ALERT_NO_DATA_EVERY_MIN
#   ONLINE_MIA_DATA_SOURCE
#   ONLINE_MIA_API_TICKERS
#   ONLINE_MIA_API_STALE_MIN
#   ONLINE_MIA_API_TIMEOUT_SEC
#   ONLINE_MIA_ORDERBOOK_ENABLE / ONLINE_MIA_ORDERBOOK_TICKERS / ONLINE_MIA_ORDERBOOK_TIMEOUT_SEC
Environment=ONLINE_MIA_REPORTS_DIR=/var/log/muhlya-reports
Environment=ONLINE_MIA_CANDLE_SHORT_MIN=5
Environment=ONLINE_MIA_CANDLE_LONG_MIN=15
Environment=ONLINE_MIA_CANDLE_MIN_POINTS=1
Environment=ONLINE_MIA_CANDLE_FALLBACK_MIN=45
Environment=ONLINE_MIA_CANDLE_USE_FALLBACK_IN_ACTIVE=1
Environment=ONLINE_MIA_BULLISH_THRESHOLD_PCT=55
Environment=ONLINE_MIA_BEARISH_THRESHOLD_PCT=35
Environment=ONLINE_MIA_ALERT_NO_DATA_EVERY_MIN=10
Environment=ONLINE_MIA_DATA_SOURCE=api_first
Environment=ONLINE_MIA_API_TICKERS=SBER,GAZP,LKOH,ROSN,NVTK,TATN,VTBR,MGNT,NLMK,SNGSP,TATNP,SGZH
Environment=ONLINE_MIA_API_STALE_MIN=20
Environment=ONLINE_MIA_API_TIMEOUT_SEC=6
Environment=ONLINE_MIA_ORDERBOOK_ENABLE=1
Environment=ONLINE_MIA_ORDERBOOK_TIMEOUT_SEC=4
Environment=ONLINE_MIA_LIQUIDITY_ENABLE=1
Environment=ONLINE_MIA_LIQUIDITY_TIMEOUT_SEC=6
Environment=ONLINE_MIA_TZ=Europe/Moscow

WorkingDirectory=/opt/trading/app/moex-trader-gui
ExecStart=/opt/trading/app/moex-trader-gui/scripts/vps/miya-online-watch.sh
