### Пример переменных окружения (НЕ храните секреты в git)
### Скопируйте в .env локально или задайте переменные в системе.

# Соответствие тикеров MOEX ISS → символ Finam (опционально). Формат см. finam_symbol_overrides.json.example
# Справочник фьючерсов в ЛК: https://ai.finam.ru/futures
# Полный дамп из экспорта скринера Finam (.xlsx → JSON): scripts/import_screener_xlsx_to_overrides.py → finam_symbol_overrides_screener.json
# Если переменная не задана: автоматически подхватывается первый существующий файл (cwd, затем каталог exe):
#   finam_symbol_overrides.json (личный, приоритет) → finam_symbol_overrides_screener.json (в репозитории).
# FINAM_SYMBOL_OVERRIDES_PATH=./finam_symbol_overrides.json
# FINAM_SYMBOL_OVERRIDES_PATH=./finam_symbol_overrides_screener.json
# Авто-индекс фьючерсов Finam (gRPC AllAssets, MIC=FUT) — подбор Symbol для заявки; 0 = только ручные overrides + TICKER@FUT
# AGENT_FINAM_FUTURES_SYMBOL_INDEX=1
# TTL кэша индекса (часы)
# AGENT_FINAM_FUTURES_INDEX_TTL_HOURS=6
# Перед заявкой на фьючерс: проверка gRPC GetAsset (0 = выключить)
# AGENT_FINAM_GETASSET_PREFLIGHT=1
# Негативный кэш при NotFound/«нет инструмента» (сек; по умолчанию 120; 0 = не кэшировать)
# AGENT_FINAM_GETASSET_NOTFOUND_CACHE_SEC=120
# Если GetAsset успешен по альтернативному символу (MOEX SECID ≠ Finam) — запомнить в памяти до перезапуска (0 = выключить)
# AGENT_FINAM_FUTURES_SYMBOL_LEARN=1

# Finam
# Secret token из раздела «Токены» (значение, которым обмениваетесь на JWT через POST /v1/sessions).
# Не путать с JWT из ответа Auth и не светить в чатах — при утечке перевыпустите токен на портале.
FINAM_SECRET_REAL=

# Если в ЛК «Доступ к счетам» / торговый код вида 133359RLB2K, а в sessions/details в account_ids только цифры —
# приложение может взять код из поля trading_code ответа автоматически. Явный override всё равно можно задать:
# FINAM_ACCOUNT_ID=133359RLB2K

# Тариф Finam N3 «Инвестор» (фондовый рынок MOEX, акции): условия и шкала — https://broker.finam.ru/landing/tariffs-n3-investor/
# Доли в десятичном виде (0.025% = 0.00025). Дефолты в коде — оценка; сверяйте с офертой/ЛК и при необходимости переопределяйте.
# Комиссия брокера за одну «ногу» (типичная нижняя публичная ставка по MOEX для «Инвестор» — 0,025%)
FINAM_TARIFF_MOEX_STOCK_BROKER_LEG_PCT=0.00025
# Клиринг МосБиржи за ногу (акции, не облигации РФ). Для облигаций РФ на MOEX: 0.00015
FINAM_TARIFF_MOEX_STOCK_CLEARING_LEG_PCT=0.0003
# Иная ставка/ступень по обороту — из тарифа на сайте или ЛК, подставьте сюда (пример: 0,030% = 0.0003)
# СПБ Биржа (урегулирование): 0,01% за ногу — задайте отдельно, если торгуете только СПБ
# Запас на проскальзывание (не комиссия, эвристика)
FINAM_TARIFF_SLIPPAGE_RESERVE_PCT=0.0005

# Минимальная сумма сделки по акциям для агента (₽), чтобы не есть прибыль оборотом
AGENT_MIN_STOCK_NOTIONAL_RUB=5000
# Профиль «низкий кэш на счёте» (~9–15k ₽): если в runtime часто `skip_buy_no_affordable_after_scan`, можно одним
# пакетом чуть снизить порог notional, ослабить VALTODAY-фильтр и расширить пул buy-кандидатов (в коде лимит 4..30):
#   AGENT_MIN_STOCK_NOTIONAL_RUB=1000
#   AGENT_MIN_TURNOVER_RUB=120000
#   AGENT_BUY_CANDIDATES_LIMIT=30
# На прод-VPS тюнить осознанно: шире universe = больше «тонких» бумаг и шума; контролировать `auto.order_*` / reject.

# Блокировка тикера (в минутах) после брокерской ошибки "Invalid quantity value".
# Нужна, чтобы агент не спамил одинаковые невалидные заявки.
AGENT_BAD_TICKER_COOLDOWN_MIN=30

# Статический denylist тикеров (через запятую/пробел), чтобы оперативно исключить "токсичные" бумаги.
# Форматы с суффиксами поддерживаются: DIAS, DIAS@MISX, DIAS_TQBR.
# AGENT_TICKER_DENYLIST=DIAS,RNFT
# Whitelist акций (по умолчанию файл ЛЧИ в репозитории). Применяется только к акциям.
# Фьючерсы/опционы этим списком не ограничиваются.
# AGENT_STOCK_ALLOWLIST_PATH=./config/lchi_stocks_allowlist.txt
# Опциональный whitelist фьючерсов (по одному тикеру в строке).
# Если не задан — фьючерсы не ограничиваются.
# AGENT_FUTURES_ALLOWLIST_PATH=./config/lchi_futures_allowlist.txt
# Авто-обновление futures allowlist по итогам preflight (добавляет прошедшие, удаляет NotFound).
# AGENT_FUTURES_ALLOWLIST_AUTO_LEARN=1

# Режим пула инструментов для headless-авто:
# auto/all (акции+фьючерсы), stocks, futures, options, fixed.
# Подробно: ../docs/MOEX_FORTS_AUTO_UNIVERSE.md
# Для fixed можно задать тикер отдельно:
# AGENT_AUTO_INSTRUMENT_MODE=auto
# AGENT_AUTO_FIXED_TICKER=SBER
# Динамический gate по TRADINGSTATUS конкретного тикера:
# 1 = если тикер закрыт (N), пропускаем только сейчас; при T снова торгуем автоматически.
AGENT_STRICT_TRADINGSTATUS_GATE=1
# TTL кэша статуса тикера (сек), чтобы не долбить ISS в каждом цикле.
AGENT_TRADINGSTATUS_TTL_SEC=30

# Доля кэша, доступная Мухле в auto-режиме (10..100, шаг 10).
AGENT_AUTO_BUDGET_PERCENT=100
# Дополнительный коэффициент использования кэша внутри расчёта qty (0..1):
# 1.00 = использовать весь доступный кэш (с учётом комиссий/лотов).
AGENT_CASH_USAGE_RESERVE=1.00

# Автовыход из позиции (в %): фиксация прибыли и ограничение убытка.
# Пример: 1.2 = +1.2% TP; 0.8 = -0.8% SL.
AGENT_POSITION_TP_PCT=1.2
AGENT_POSITION_SL_PCT=0.8
# Ограничение "протухания" позиции: при удержании дольше лимита и слабом PnL позиция закрывается.
AGENT_POSITION_MAX_HOLD_MIN=180
AGENT_POSITION_STALE_BAND_PCT=0.25
# Трейлинг-стоп (только акции TQBR): после нереализованной прибыли ≥ AGENT_TRAILING_ACTIVATE_PCT%
# линия выхода подтягивается к цене с шагом AGENT_TRAILING_STEP_PCT% (в коде кламп 0.3–0.5%).
# Не ослабляет исходный SL (AGENT_POSITION_SL_PCT) от входа.
AGENT_TRAILING_STOP_ENABLED=1
AGENT_TRAILING_ACTIVATE_PCT=0.5
AGENT_TRAILING_STEP_PCT=0.35
# Профиль выхода: conservative | adaptive | auto.
# auto: open/close, low-balance и серия убытков -> conservative; mid без стрика -> adaptive.
AGENT_EXIT_PROFILE_MODE=auto
AGENT_EXIT_AUTO_CONSERVATIVE_STREAK=2
# Множители для профиля conservative (быстрее режем риск, раньше защищаем прибыль).
AGENT_EXIT_CONSERVATIVE_TP_MUL=0.90
AGENT_EXIT_CONSERVATIVE_SL_MUL=0.75
AGENT_EXIT_CONSERVATIVE_TRIGGER_MUL=0.85
AGENT_EXIT_CONSERVATIVE_TRAIL_MUL=0.70
AGENT_EXIT_CONSERVATIVE_STALE_BAND_MUL=0.85
AGENT_EXIT_CONSERVATIVE_MAX_HOLD_MUL=1.20
AGENT_EXIT_CONSERVATIVE_FASTMOVE_MUL=0.85
# Множители для профиля adaptive (даём прибыли «дышать», но чуть расширяем допуски).
AGENT_EXIT_ADAPTIVE_TP_MUL=1.10
AGENT_EXIT_ADAPTIVE_SL_MUL=1.05
AGENT_EXIT_ADAPTIVE_TRIGGER_MUL=1.05
AGENT_EXIT_ADAPTIVE_TRAIL_MUL=1.20
AGENT_EXIT_ADAPTIVE_STALE_BAND_MUL=1.15
AGENT_EXIT_ADAPTIVE_MAX_HOLD_MUL=0.90
AGENT_EXIT_ADAPTIVE_FASTMOVE_MUL=1.10
# Память точек выхода по тикерам (Мухля): JSON-файл с авто-обновлением.
AGENT_EXIT_LEARNING_PATH=data/exit_learning.json
# Минимум завершённых выходов по тикеру, после которого включается множитель TP из exit_learning (2..40).
AGENT_EXIT_LEARNING_MIN_SAMPLES=5
# Машинные подсказки от Мии (формат KEY=VALUE, DEFAULT и тикеры).
AGENT_MIA_EXIT_HINTS_PATH=/var/log/muhlya-reports/agent_exit_hints.env
# Онлайн-сигнал от Мии (STATE/DATA_STATUS/DEFAULT/UP_RATIO_PCT из miya_online_signal.env).
AGENT_MIA_ONLINE_SIGNAL_PATH=/var/log/muhlya-reports/miya_online_signal.env
# Включить мягкую интеграцию онлайн-подсказки Мии в decision-gates Мухли.
AGENT_MIA_ONLINE_HINTS_ENABLED=1
# Максимальный сдвиг buy-gate от онлайн-подсказки Мии (0..0.15).
AGENT_MIA_ONLINE_BUY_GATE_MAX_DELTA=0.04
# Максимальный сдвиг short-open gate от онлайн-подсказки Мии (0..0.30).
AGENT_MIA_ONLINE_SHORT_GATE_MAX_DELTA=0.15
# Доля дневного среза Мии (DAILY_* в miya_online_signal.env) в смешивании гейтов: 0 = только intraday, 1 = только дневной.
AGENT_MIA_ONLINE_DAILY_GATE_WEIGHT=0.35
# Когда акции по MOEX закрыты (SBER TRADINGSTATUS != T), насколько ослабить intraday-слой Мии в сдвиге гейтов (0..1). 1 = без ослабления.
AGENT_MIA_ONLINE_STOCK_CLOSED_INTRADAY_SCALE=0.35
# Сначала только акции из MIYA_WATCH_TICKERS (тот же список, что ONLINE_MIA_API_TICKERS); если кандидатов нет — полный универсум (без штрафов).
AGENT_MIA_WATCH_FIRST_ENABLED=1
# Бонус к rankScore для акций по рангу ликвидности из miya_online_signal.env (MIYA_LIQUIDITY_ORDER — пишет Мия).
AGENT_MIA_LIQUIDITY_RANK_ENABLED=1
AGENT_MIA_LIQUIDITY_RANK_WEIGHT=0.02
# Пауза (сек) на новые входы после risk-reject по daily notional exceed.
AGENT_RISK_DAILY_REJECT_PAUSE_SEC=60

# Снимок портфеля Finam на диск (Мия читает без своих запросов к брокеру). Пишется из autoLoop на основе уже полученного GetPortfolio().
AGENT_BROKER_POSITION_SNAPSHOT_ENABLED=1
AGENT_BROKER_POSITION_SNAPSHOT_PATH=/var/log/muhlya-reports/broker_positions_snapshot.json
# Минимум секунд между перезаписями файла (анти-спам по диску/косвенно по Finam).
AGENT_BROKER_POSITION_SNAPSHOT_MIN_SEC=10
# Вне торговой сессии — реже обновлять снимок (один лишний GetPortfolio только если прошёл интервал).
AGENT_BROKER_POSITION_SNAPSHOT_CLOSED_MIN_SEC=300

# Лимиты риск-менеджера (notional в рублях): работают и в headless.
AGENT_MAX_ORDER_NOTIONAL=50000
AGENT_MAX_DAILY_NOTIONAL=500000
# Автоподстройка дневного лимита (оценка на границе суток по фактической загрузке лимита).
# В safe-режиме сначала только рекомендация в runtime_events, без автоприменения.
AGENT_DAILY_NOTIONAL_TUNE_ENABLED=1
AGENT_DAILY_NOTIONAL_TUNE_APPLY=0
# Коридор авто-лимита (руб).
AGENT_DAILY_NOTIONAL_TUNE_MIN=120000
AGENT_DAILY_NOTIONAL_TUNE_MAX=600000
# Целевой диапазон загрузки лимита за день (доли 0..1).
AGENT_DAILY_NOTIONAL_TUNE_TARGET_LOW_UTIL=0.40
AGENT_DAILY_NOTIONAL_TUNE_TARGET_HIGH_UTIL=0.85
# Шаги изменения лимита (в процентах).
AGENT_DAILY_NOTIONAL_TUNE_UP_STEP_PCT=10
AGENT_DAILY_NOTIONAL_TUNE_DOWN_STEP_PCT=10

# Минимальная уверенность для открытия шорта по сигналу sell из flat.
AGENT_SHORT_CONF_THRESHOLD=0.74
# Базовые confidence-пороги для long/sell (в автоцикле адаптируются мягко).
AGENT_BUY_CONF_THRESHOLD=0.68
AGENT_SELL_CONF_THRESHOLD=0.60
# Зеркальный gate short-open к buy-entry (1=true, 0=false).
AGENT_MIRROR_SHORT_TO_BUY_GATE=1
# Симметрия MTF-подтверждений: 0 = без послабления только для buy.
AGENT_MTF_BUY_RELAX_DELTA=0

# "Мозги v3": тренд + моментум + волатильность (по умолчанию включены).
AGENT_REQUIRE_TREND_FILTER=1
AGENT_REQUIRE_MACD_CONFIRM=1
# Для buy ждём откат RSI не выше уровня, для sell/short — не ниже.
AGENT_RSI_PULLBACK_BUY_MAX=45
AGENT_RSI_PULLBACK_SELL_MIN=55
# Волатильностный фильтр (в % от цены, прокси по close-to-close).
AGENT_VOLATILITY_MAX_PCT=4.0

# A/B/C-эксперименты: режим подбирается по времени (слоты) и тикеру.
# Полезно, чтобы сравнить, какой профиль лучше по разным инструментам/окнам сессии.
AGENT_ABTEST_ENABLED=0
AGENT_ABTEST_SLOT_MIN=15
# Лимит числа buy-попыток в одном цикле авто (анти-спам при нехватке денег/висящих заявках).
AGENT_MAX_BUY_ATTEMPTS_PER_CYCLE=6
# Если есть любые pending buy-заявки, новые buy в этом цикле не отправляем (снижает [156]).
AGENT_BLOCK_NEW_BUYS_WHEN_PENDING=1
# Максимальное время (мин) глобального pending-buy блока; после лимита включается выборочный bypass.
AGENT_PENDING_GLOBAL_BLOCK_MAX_MIN=45
# Глобальный рубильник short-open (0=выкл, 1=вкл).
AGENT_SHORT_OPEN_ENABLED=1
# Глобальная пауза short-open (мин), когда брокер вернул [157]/[257].
AGENT_SHORT_OPEN_GLOBAL_PAUSE_MIN=20
# Тикерная пауза short-open (мин) после [157]/[257], чтобы не долбить один и тот же инструмент.
AGENT_SHORT_OPEN_TICKER_BLOCK_157_MIN=180

# Open-bias (10:00..open-phase): поддержка long-входов на открытии при контроле риска.
AGENT_OPEN_LONG_BIAS=1
# Насколько ослабить gate buy в фазе open (0..0.15).
AGENT_OPEN_BUY_GATE_DELTA=0.04
# Насколько ужесточить gate short-open в фазе open (0..0.30).
AGENT_OPEN_SHORT_GATE_PENALTY=0.15
# Дополнительные buy-попытки в одном цикле в фазе open (0..6).
AGENT_OPEN_MAX_BUY_ATTEMPTS_BONUS=3
# Дополнительно: в фазе open отфильтровать фьючерсы из universe (1=да, 0=нет).
# Безопасная реализация: фильтрация до ранжирования кандидатов.
AGENT_OPEN_STOCKS_ONLY=0

# Фазы сессии для метрик (Europe/Moscow): длительность «открытия» и «закрытия» в минутах (основная сессия акций).
AGENT_SESSION_PHASE_OPEN_MIN=45
AGENT_SESSION_PHASE_CLOSE_MIN=45

# Жёсткий фильтр ликвидности для авто-универсума.
AGENT_MIN_NUMTRADES=100
AGENT_MIN_TURNOVER_RUB=2000000

# Насколько сильно история успешных/плохих сделок влияет на confidence.
AGENT_LEARNING_CONF_WEIGHT=0.12
# Минимум записей в trades по тикеру в окне getTickerLearningScores: до порога вклад обучения масштабируется линейно (анти-шум).
AGENT_LEARNING_MIN_TRADES_PER_TICKER=6

# Мягкий вес реализованного P/L по тикеру в ранжировании кандидатов (0..0.35).
# Рекомендуемый старт: 0.08 (консервативно, без перекоса).
AGENT_PNL_SCORE_WEIGHT=0.08
# Минимум строк сделок по тикеру, участвовавших в разборе PnL: до порога score масштабируется (анти-перекос на 1–2 сделки).
AGENT_PNL_SCORE_MIN_TRADES=8

# Affordability-first ранжирование входов:
# чем выше исполнимый объём относительно желаемого, тем выше приоритет кандидата.
# Вес влияния исполнимости в итоговом ранге buy-кандидата (0..0.60).
AGENT_AFFORDABILITY_SCORE_WEIGHT=0.22
# Минимальная доля исполнимого объёма (0..1), ниже которой кандидат штрафуется в ранге.
AGENT_AFFORDABILITY_MIN_EXEC_RATIO=0.20
# Вклад "ожидаемой прибыли" в rankScore buy-кандидата:
# edge = (confidence - buy_gate), затем вычитаются издержки полного круга.
AGENT_EXPECTED_PROFIT_WEIGHT=0.45
AGENT_EXPECTED_PROFIT_COST_SCALE=12
# Оценка round-trip издержек для фьючерсов (доля, например 0.09% = 0.0009).
AGENT_FUTURES_ROUND_TRIP_COST_PCT=0.0009

# Раздельные пороги минимального баланса для разных режимов.
# Ниже порога Мухля уходит в manage-only (без новых входов).
AGENT_MIN_BALANCE_STOCK=200
AGENT_MIN_BALANCE_FUTURES=100

# Runtime events в Postgres: ограничение хвоста (авто-очистка старых).
AGENT_RUNTIME_EVENTS_DB_LIMIT=500
# Мия (server scripts): срок хранения intraday/daily отчётов в днях.
ONLINE_MIA_REPORT_RETENTION_DAYS=14
# Мия online-watch: не спамить ALERT no_data чаще, чем раз в N минут.
ONLINE_MIA_ALERT_NO_DATA_EVERY_MIN=10
# Мия report: путь к JSON-снимку портфеля (пишет Мухля) и порог «устарел» для fallback на Postgres.
ONLINE_MIA_BROKER_SNAPSHOT_PATH=/var/log/muhlya-reports/broker_positions_snapshot.json
ONLINE_MIA_BROKER_SNAPSHOT_STALE_SEC=900
# Мия online-watch: источник свечей.
# api_first = сначала MOEX ISS API, при no_data fallback в БД;
# auto = как api_first (оставлен для совместимости);
# db_only = только market_data из Postgres.
ONLINE_MIA_DATA_SOURCE=api_first
# Список тикеров для бесплатного API-профиля Мии (через запятую).
ONLINE_MIA_API_TICKERS=SBER,GAZP,LKOH,ROSN,NVTK,TATN,VTBR,MGNT,NLMK,SNGSP,TATNP,SGZH
# Дополнительные тикеры для MIYA_WATCH_TICKERS (например, фьючерсы FORTS: GZM6,SRM6,SiM6).
# В candles/orderbook Мии пока не участвуют: это «watch-подсказка» для Мухли поверх ONLINE_MIA_API_TICKERS.
ONLINE_MIA_FUTURES_WATCH_TICKERS=
# Сколько минут считаем API-свечу "устаревшей" для онлайн-сигнала.
ONLINE_MIA_API_STALE_MIN=20
# Таймаут HTTP-запроса к MOEX ISS (сек) на тикер.
ONLINE_MIA_API_TIMEOUT_SEC=6
# Мия online-watch: дневные свечи (тот же ISS /candles.json, interval=24, тикеры = ONLINE_MIA_API_TICKERS).
# Пишет DAILY_* в miya_online_signal.env; Мухля смешивает с intraday (AGENT_MIA_ONLINE_DAILY_GATE_WEIGHT).
ONLINE_MIA_DAILY_ENABLE=1
ONLINE_MIA_DAILY_LOOKBACK_DAYS=45
ONLINE_MIA_DAILY_MIN_BARS=2
ONLINE_MIA_DAILY_BULLISH_THRESHOLD_PCT=55
ONLINE_MIA_DAILY_BEARISH_THRESHOLD_PCT=35
# Мия: снимок лучших цен / видимой глубины (MOEX ISS marketdata, TQBR). См. docs/MIYA_ORDERBOOK.md
# Полный многоуровневый стакан в ISS часто только по подписке — здесь публичные bid/offer/last и depth, если биржа заполняет.
ONLINE_MIA_ORDERBOOK_ENABLE=1
# Пусто = те же тикеры, что ONLINE_MIA_API_TICKERS
# ONLINE_MIA_ORDERBOOK_TICKERS=SBER,GAZP,LKOH
ONLINE_MIA_ORDERBOOK_TIMEOUT_SEC=4
# Ранг ликвидности (MOEX ISS VALTODAY) → MIYA_LIQUIDITY_* в miya_online_signal.env; список = ONLINE_MIA_API_TICKERS.
ONLINE_MIA_LIQUIDITY_ENABLE=1
ONLINE_MIA_LIQUIDITY_TIMEOUT_SEC=6

# Fast-Move Guard (аварийная фиксация при резком движении в прибыль).
# По умолчанию включаем консервативно.
AGENT_FASTMOVE_ENABLED=true
# Триггер в процентах прибыли за короткое окно.
AGENT_FASTMOVE_TRIGGER_PCT=1.4
# Размер окна в секундах для "резкого движения".
AGENT_FASTMOVE_WINDOW_SEC=180

# Опционально: JSON-политика агента (см. agent_policy.finam_n3.example.json)
# AGENT_POLICY_PATH=

# -------------------------------------------------------------
# Быстрые профили (скопируйте нужный блок в локальный .env)
#
# [Профиль: Консервативный]
# AGENT_AUTO_BUDGET_PERCENT=40
# AGENT_POSITION_TP_PCT=1.4
# AGENT_POSITION_SL_PCT=0.9
# AGENT_PNL_SCORE_WEIGHT=0.06
# AGENT_FASTMOVE_ENABLED=true
# AGENT_FASTMOVE_TRIGGER_PCT=1.8
# AGENT_FASTMOVE_WINDOW_SEC=150
#
# [Профиль: Активный]
# AGENT_AUTO_BUDGET_PERCENT=70
# AGENT_POSITION_TP_PCT=1.0
# AGENT_POSITION_SL_PCT=1.1
# AGENT_PNL_SCORE_WEIGHT=0.10
# AGENT_FASTMOVE_ENABLED=true
# AGENT_FASTMOVE_TRIGGER_PCT=1.2
# AGENT_FASTMOVE_WINDOW_SEC=210
# -------------------------------------------------------------



# Postgres (используется для симуляции/локального учёта и хранения данных)
PGHOST=localhost
PGPORT=5433
PGUSER=trader
PGPASSWORD=
PGDATABASE=moex_trading

